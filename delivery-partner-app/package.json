{
  "name": "urban-delivery-partner-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3002",
    "build": "vite build",
    "preview": "vite preview --port 3002",
    "cap:sync": "npm run build && npx cap sync android",
    "build:apk": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "build:aab": "npm run cap:sync && cd android && gradlew.bat bundleRelease",
    "open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.7"
  }
}
