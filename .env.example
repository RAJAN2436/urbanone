# MongoDB Connection String (MERN Stack)
# Local: mongodb://127.0.0.1:27017/kalsen or MongoDB Atlas URI: mongodb+srv://<user>:<password>@cluster.mongodb.net/kalsen
MONGODB_URI=mongodb://127.0.0.1:27017/kalsen

# Twilio SMS Gateway Configuration
# Get your Twilio credentials at https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Fast2SMS API Key (Alternative)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Server Port & Settings
PORT=5000
NODE_ENV=development

# Cloudinary CDN Configuration (Image Storage Across Entire Platform & Dashboards)
# Get your free Cloudinary credentials at https://cloudinary.com/console
# Client-side Unsigned Direct Upload:
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_here
# Backend Server-side Upload:
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
# Alternatively use single URL:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
